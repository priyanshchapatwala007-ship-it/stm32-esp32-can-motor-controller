[
    {
        "id": "flow_motor_dashboard",
        "type": "tab",
        "label": "Motor Controller Dashboard",
        "disabled": false,
        "info": "CAN Motor Controller - MQTT Dashboard\nSubscribes to robot/motor/telemetry\nPublishes to robot/motor/setpoint"
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "HiveMQ Public",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "mqtt_in_telemetry",
        "type": "mqtt in",
        "z": "flow_motor_dashboard",
        "name": "Telemetry IN",
        "topic": "robot/motor/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 200,
        "wires": [["parse_telemetry", "debug_telemetry"]]
    },
    {
        "id": "parse_telemetry",
        "type": "function",
        "z": "flow_motor_dashboard",
        "name": "Parse Telemetry",
        "func": "var rpm = msg.payload.rpm || 0;\nvar target = msg.payload.target || 0;\nvar error = target - rpm;\n\n// Store in flow context for gauge nodes\nflow.set('current_rpm', rpm);\nflow.set('target_rpm', target);\nflow.set('error', error);\n\n// Output 1: RPM gauge\n// Output 2: Target gauge  \n// Output 3: Error display\n// Output 4: Chart data\nvar msg1 = { payload: rpm };\nvar msg2 = { payload: target };\nvar msg3 = { payload: error.toFixed(2) };\nvar msg4 = { payload: [{ \"series\": [\"Actual RPM\", \"Target RPM\"], \"data\": [[rpm], [target]], \"labels\": [new Date().toLocaleTimeString()] }] };\n\nreturn [msg1, msg2, msg3, msg4];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 200,
        "wires": [["gauge_rpm"], ["gauge_target"], ["text_error"], ["chart_rpm"]]
    },
    {
        "id": "debug_telemetry",
        "type": "debug",
        "z": "flow_motor_dashboard",
        "name": "Telemetry Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 370,
        "y": 280,
        "wires": []
    },
    {
        "id": "ui_tab_main",
        "type": "ui_tab",
        "name": "Motor Control",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "ui_group_gauges",
        "type": "ui_group",
        "name": "Live Gauges",
        "tab": "ui_tab_main",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_group_chart",
        "type": "ui_group",
        "name": "RPM History",
        "tab": "ui_tab_main",
        "order": 2,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "ui_group_controls",
        "type": "ui_group",
        "name": "Controls",
        "tab": "ui_tab_main",
        "order": 3,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "gauge_rpm",
        "type": "ui_gauge",
        "z": "flow_motor_dashboard",
        "name": "RPM",
        "group": "ui_group_gauges",
        "order": 1,
        "width": "6",
        "height": "4",
        "gtype": "gage",
        "title": "Current RPM",
        "label": "RPM",
        "format": "{{value | number:1}}",
        "min": 0,
        "max": "300",
        "colors": ["#00d4ff", "#ffaa00", "#ff4444"],
        "seg1": "100",
        "seg2": "200",
        "diff": false,
        "className": "",
        "x": 610,
        "y": 120,
        "wires": []
    },
    {
        "id": "gauge_target",
        "type": "ui_gauge",
        "z": "flow_motor_dashboard",
        "name": "Target",
        "group": "ui_group_gauges",
        "order": 2,
        "width": "6",
        "height": "4",
        "gtype": "gage",
        "title": "Target RPM",
        "label": "RPM",
        "format": "{{value | number:1}}",
        "min": 0,
        "max": "300",
        "colors": ["#ffaa00", "#ffaa00", "#ff4444"],
        "seg1": "100",
        "seg2": "200",
        "diff": false,
        "className": "",
        "x": 610,
        "y": 180,
        "wires": []
    },
    {
        "id": "text_error",
        "type": "ui_text",
        "z": "flow_motor_dashboard",
        "group": "ui_group_gauges",
        "order": 3,
        "width": "6",
        "height": "1",
        "name": "Error",
        "label": "PID Error",
        "format": "{{msg.payload}} RPM",
        "layout": "row-spread",
        "className": "",
        "style": false,
        "font": "",
        "fontSize": 16,
        "color": "#ff6b6b",
        "x": 610,
        "y": 240,
        "wires": []
    },
    {
        "id": "chart_rpm",
        "type": "ui_chart",
        "z": "flow_motor_dashboard",
        "name": "RPM Chart",
        "group": "ui_group_chart",
        "order": 1,
        "width": "12",
        "height": "6",
        "label": "RPM Over Time",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Waiting for telemetry...",
        "dot": false,
        "ymin": "0",
        "ymax": "350",
        "removeOlder": "2",
        "removeOlderPoints": "",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": ["#00d4ff", "#ffaa00", "#ff6384", "#ff9f40", "#4bc0c0", "#9966ff", "#c9cbcf"],
        "outputs": 1,
        "useDifferentColor": false,
        "className": "",
        "x": 610,
        "y": 300,
        "wires": [[]]
    },
    {
        "id": "slider_setpoint",
        "type": "ui_slider",
        "z": "flow_motor_dashboard",
        "name": "Speed Slider",
        "label": "Set Target RPM",
        "tooltip": "",
        "group": "ui_group_controls",
        "order": 1,
        "width": "6",
        "height": "1",
        "passthru": false,
        "outs": "end",
        "topic": "setpoint",
        "topicType": "str",
        "min": 0,
        "max": "300",
        "step": "5",
        "className": "",
        "x": 150,
        "y": 440,
        "wires": [["mqtt_out_setpoint", "debug_setpoint"]]
